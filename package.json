{
  "name": "agente-cpi",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache . --ignore-pattern docs/superpowers/evidence/**",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "pnpm run rebuild:native",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test": "tsx scripts/run-vitest-electron.ts run",
    "test:watch": "tsx scripts/run-vitest-electron.ts",
    "test:coverage": "tsx scripts/run-vitest-electron.ts run --coverage",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "playwright:install": "playwright install chromium",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "browser:smoke": "tsx scripts/browser-smoke-test.ts",
    "sessions:inspect": "tsx scripts/inspect-platform-sessions.ts",
    "cpi:inspect-queue": "tsx scripts/inspect-cpi-queue.ts",
    "cpi:test-controls": "tsx scripts/test-cpi-queue-controls.ts",
    "cpi:test-monitor": "tsx scripts/test-cpi-continuous-monitor.ts",
    "cpi:inspect-first": "tsx scripts/inspect-cpi-first-research.ts",
    "cpi:test-open-first": "tsx scripts/test-cpi-open-first-research.ts",
    "cpi:inspect-form": "tsx scripts/inspect-cpi-research-form.ts",
    "cpi:simulate-result": "tsx scripts/simulate-cpi-research-result.ts",
    "deskdata:inspect-pdf-download": "tsx scripts/inspect-deskdata-pdf-download.ts",
    "deskdata:prepare-next-search": "tsx scripts/prepare-next-deskdata-search.ts",
    "cpi:inspect-pdf-attachment": "tsx scripts/inspect-cpi-pdf-attachment.ts",
    "cpi:retry-save-latest-pdf": "tsx scripts/retry-cpi-save-with-latest-pdf.ts",
    "cpi:save-result": "tsx scripts/save-cpi-research-result.ts",
    "deskdata:inspect-search": "tsx scripts/inspect-deskdata-search.ts",
    "flow:test-cpf-transfer": "tsx scripts/test-cpi-to-deskdata-cpf.ts",
    "deskdata:test-datasets": "tsx scripts/test-deskdata-approved-datasets.ts",
    "flow:test-submit": "tsx scripts/test-cpi-to-deskdata-submit.ts",
    "flow:run-supervised": "tsx scripts/run-full-supervised-research.ts",
    "deskdata:inspect-result": "tsx scripts/inspect-deskdata-process-result.ts",
    "flow:run-continuous": "tsx scripts/run-continuous-auto-research.ts",
    "rebuild:native": "electron-rebuild --force --which-module better-sqlite3 --arch x64 --sequential"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.3.9",
    "pdf-parse": "2.4.5",
    "playwright": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  }
}
